# FlightChain Environment Variables

# Pinata API
# Get this from: app.pinata.cloud → Avatar → API Keys → Generate New Key
# Select: pinFileToIPFS, pinJSONToIPFS
PINATA_JWT=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# XRPL Wallet (optional for demo, required for production)
# Your airline's XRPL account seed (sXXXXX format)
XRPL_WALLET_SEED=sYourWalletSeedHere...

# XRPL Network
# testnet for demo, mainnet for production
XRPL_NETWORK=testnet

# Dynamic NFT Token ID (get this after you mint on XRPL)
XRPL_NFT_TOKEN_ID=000100001E962F495F07A990F4ED55D2410B5D63A5C

# Escrow Details
ESCROW_RLUSD_AMOUNT=100000
RESCUE_TEAM_ADDRESS=rN7n7otQDd6FczFgLdllmHNwSueY2sPfwgnn
